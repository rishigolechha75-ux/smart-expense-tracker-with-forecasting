# Copy to .env (or export these) before running the API.
# Leave DATABASE_URL unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_tracker
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
